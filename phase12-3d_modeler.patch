-  if (asGiven && rotated) {
-    const asGivenSlack = maxHeightMm - asGiven.heightMm;
-    const rotatedSlack = maxHeightMm - rotated.heightMm;
-    return rotatedSlack < asGivenSlack ? rotated : asGiven;
-  }
