-  { id: 'drawers', name: 'Drawer boxes, fronts & handles', run: runDrawers },
-  { id: 'guides', name: 'Drawer guides on carcass panels', run: runGuides },
-  { id: 'plinth', name: 'Plinth', run: runPlinth },
-  { id: 'carcass', name: 'Main carcass', run: runCarcass },
