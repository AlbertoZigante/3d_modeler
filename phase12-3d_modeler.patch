-        panel: rawById.get(b.candidateId),
-        resolved: resolvedById.get(b.candidateId),
-        role: bRole,
-        joints: b.connecting,
-        orientation: desiredOrientation(bRole),
-        fromOrientation: desiredOrientation(panelRole(rawById.get(placed[placed.length - 1]))),
-        kind: 'join',
