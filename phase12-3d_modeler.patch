-function fitsAsGiven(piece, maxWidthMm, maxHeightMm) {
-  return piece.widthMm <= maxWidthMm && piece.heightMm <= maxHeightMm;
-}
-
-function fitsRotated(piece, maxWidthMm, maxHeightMm) {
