{
  "name": "3d_modeler",
  "version": "0.1.0",
  "description": "Browser-based 3D furniture design tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "golden:dump": "node scripts/golden/dump-golden.mjs",
    "golden:check": "node scripts/golden/check-golden.mjs",
    "api:types": "node scripts/api/sync-contract.mjs --api ../api/openapi.json",
    "api:types:check": "node scripts/api/sync-contract.mjs --check",
    "golden:legacy": "node scripts/golden/legacy-oracle.mjs",
    "test:unit": "node tests/requester.test.mjs && node tests/http.test.mjs && node tests/contract.test.mjs && node tests/payload.test.mjs",
    "test:e2e": "node tests/cutlist.integration.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "add": "^2.0.6",
    "jspdf": "^4.2.1",
    "package-lock.json": "^1.0.0",
    "three": "^0.185.1"
  }
}
