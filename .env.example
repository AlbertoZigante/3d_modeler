# Backend (repo: api). Required for production builds; dev defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000
# Optional beta gate (ships in the bundle — not a secret)
VITE_API_KEY=
# Optional: base path. Default /3d_modeler/ (GitHub Pages). Use / on a custom domain.
VITE_BASE=/3d_modeler/
