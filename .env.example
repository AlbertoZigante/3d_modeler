# Backend (repo: api). Required for production builds; dev defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000
# Optional beta gate (ships in the bundle — not a secret)
VITE_API_KEY=
# Optional: base path. Default /3d_modeler/ (GitHub Pages). Use / on a custom domain.
VITE_BASE=/3d_modeler/
# Marketing site (repo: site). Dev defaults to http://localhost:4321; required for production builds.
VITE_SITE_URL=http://localhost:4321
# Server-side business logic (migration plan phase 10). Default false = the client-side JS runs, as before.
# true  = the export asks the API (needs VITE_API_URL): hardware plan for the joint report, assembly manual.
VITE_USE_API_HARDWARE=false
VITE_USE_API_ASSEMBLY=false
